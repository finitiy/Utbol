# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://my-app.run.app)
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://postgres:password@localhost:5432/futbol_uz?schema=public)
DATABASE_URL="postgresql://user:password@localhost:5432/futbol_live_db?schema=public"

# TELEGRAM_BOT_TOKEN: Telegram Bot token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_WEBHOOK_SECRET: Secret token to authenticate Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET_KEY"

# FOOTBALL_API_KEY: API key from football-data.org (free tier or paid)
FOOTBALL_API_KEY="YOUR_FOOTBALL_DATA_ORG_API_KEY"

# ADMIN_TELEGRAM_ID: Telegram User ID of the primary administrator (Default: 7853449314)
ADMIN_TELEGRAM_ID="7853449314"

# AUTH_SECRET: 32+ character random secret key for session JWT signing and cryptographic hashing
AUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"

# EMAIL_PROVIDER_API_KEY: Optional Resend / SendGrid / SMTP key for real email delivery
EMAIL_PROVIDER_API_KEY="YOUR_EMAIL_SERVICE_KEY"

